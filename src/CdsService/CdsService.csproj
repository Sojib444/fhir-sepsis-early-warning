<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CdsService</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="5.11.4" />
  </ItemGroup>

  <!-- Single source of truth for LOINC codes: the same file FhirLoader uses. -->
  <ItemGroup>
    <Content Include="../FhirLoader/LoincMap.json" CopyToOutputDirectory="PreserveNewest" Link="LoincMap.json" />
  </ItemGroup>

</Project>